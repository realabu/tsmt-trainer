{
  "name": "@tsmt/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-dist/apps/web/lib/__tests__/*.test.js",
    "test:smoke": "pnpm run test:smoke:app && pnpm run test:smoke:auth",
    "test:smoke:app": "playwright test --config=playwright.smoke.config.ts",
    "test:smoke:auth": "playwright test --config=playwright.auth-smoke.config.ts"
  },
  "dependencies": {
    "@tsmt/types": "workspace:*",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@prisma/client": "^6.5.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "bcryptjs": "^3.0.2",
    "typescript": "^5.8.2"
  }
}
